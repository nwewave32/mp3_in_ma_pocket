{
  "$description": "pocket.mp3 — Soft Keys design tokens. Mirrors lib/design/tokens.dart.",
  "color": {
    "ground":             { "light": "#E6E7E9", "dark": "#121315", "use": "App background" },
    "surface":            { "light": "#EEEFF1", "dark": "#1C1E21", "use": "Flat list panel" },
    "separator":          { "light": "#DFE0E3", "dark": "#2A2D30", "use": "Row dividers" },
    "text":               { "light": "#16181A", "dark": "#F1F2F3", "use": "File names, titles" },
    "textSecondary":      { "light": "#5E646A", "dark": "#9AA0A6", "use": "Durations, hints, screen titles" },
    "icon":               { "light": "#5E646A", "dark": "#C3C7CC", "use": "Icons on neutral keys" },
    "iconDisabled":       { "light": "#B4B8BD", "dark": "#5A5E63", "use": "Disabled key icons" },
    "panelTop":           { "light": "#F3F4F5", "dark": "#2C2F33", "use": "Raised device panel gradient (top)" },
    "panelBottom":        { "light": "#E3E4E7", "dark": "#1F2124", "use": "Raised device panel gradient (bottom)" },
    "well":               { "light": "#D9DADD", "dark": "#17181A", "use": "Recessed socket" },
    "faceTop":            { "light": "#FCFCFD", "dark": "#43464B", "use": "Key face gradient (top)" },
    "faceBottom":         { "light": "#E3E4E7", "dark": "#2F3236", "use": "Key face gradient (bottom)" },
    "facePressedTop":     { "light": "#DFE0E3", "dark": "#2A2C30", "use": "Pressed key (top)" },
    "facePressedBottom":  { "light": "#ECEDEF", "dark": "#34373B", "use": "Pressed key (bottom)" },
    "lcd":                { "light": "#D5DDC8", "dark": "#0B0C0A", "use": "LCD window" },
    "lcdInk":             { "light": "#26301F", "dark": "#FF8A3D", "use": "LCD text" },
    "lcdGlow":            { "light": "transparent", "dark": "#FF8A3D @ 55%, blur 8", "use": "LCD text glow" },
    "accent":             { "light": "#FF6A13", "dark": "#FF7A2E", "use": "Live things only: play, import, progress, LED on" },
    "accentGradient":     { "light": "#FF8A45 → #F2600A", "dark": "#FF8A45 → #F2600A", "use": "Orange key face" },
    "onAccent":           { "light": "#16181A", "dark": "#16181A", "use": "Ink on orange (never white)" },
    "accentText":         { "light": "#9A3412", "dark": "#FF8A3D", "use": "Playing row text" },
    "rowPlaying":         { "light": "#DFE0E3", "dark": "#141517", "use": "Playing row (sunk)" },
    "danger":             { "light": "#E5483B → #C9281C", "dark": "#E5483B → #C9281C", "use": "Swipe Delete" },
    "ledOff":             { "light": "#14181C @ 20%", "dark": "#FFFFFF @ 20%", "use": "LED off" }
  },
  "font": {
    "ui":   { "family": "SF Pro (system)", "figmaStandIn": "Inter" },
    "mono": { "family": "JetBrains Mono", "weights": [400, 500, 600], "license": "OFL-1.1" },
    "lcd":  { "family": "DotGothic16", "fallback": "Galmuri11 (Hangul)", "license": "OFL-1.1", "rule": "Only inside LCD windows" }
  },
  "textStyle": {
    "headerLabel": "Mono 13 / 500 / +14% tracking / uppercase / textSecondary",
    "body":        "UI 17/22 Regular",
    "bodyStrong":  "UI 17/22 SemiBold",
    "button":      "UI 17/22 SemiBold / onAccent",
    "callout":     "UI 15 / 1.45",
    "footnote":    "UI 13 / 1.45",
    "duration":    "Mono 14/18 tabular",
    "microLabel":  "Mono 11 / +10%",
    "lcdTitle":    "LCD 27 / 1.12",
    "lcdHeadline": "LCD 24 / 1.1",
    "lcdBody":     "LCD 16",
    "lcdMeta":     "LCD 13",
    "lcdMicro":    "LCD 12"
  },
  "space":  { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "12": 48, "minTap": 44, "row": 52, "header": 60 },
  "radius": { "lcdSmall": 16, "list": 20, "lcd": 22, "panel": 34, "device": 40, "pill": 999 },
  "shadow": {
    "panel":      "drop 0/18/36 #14181C 14% + 0/2/4 8% · inset top 0/1/0 white",
    "key":        "drop 0/3/6 18% + 0/1/1 12% · inset top 0/1/0 white",
    "keyPressed": "no drop · inset 0/2/5 20% · y +1 · 90ms",
    "accentKey":  "drop 0/3/6 #C2410C 35% + 0/1/1 15% · inset top 0/1/0 white 45%",
    "well":       "inset 0/3/6 20% + inset 0/-2/2 white 70% · rim 0/1/0 white 95%",
    "lcd":        "inset 0/3/7 22% + inset 0/-1/1 white 60%"
  },
  "motion": { "press": "90ms ease-out, sink 1px, haptic light", "knob": "140ms ease-out" }
}
